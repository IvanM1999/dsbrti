# Copie este arquivo para .env em desenvolvimento local.
# Não versionar .env em repositório público.

NODE_ENV=development
PORT=3000

# JWT / Sessão
JWT_SECRET=troque_esta_chave_por_uma_aleatoria
JWT_ALGORITHM=HS256
SESSION_TIMEOUT_MINUTES=30

# Usuário admin do ERP
ADMIN_EMAIL=
ADMIN_USER=
ADMIN_PASS_HASH=

# Banco PostgreSQL local ou do Render
DATABASE_URL=postgres://postgres:
DATABASE_SSL=false

# Para uso em produção no Render, a DATABASE_URL deve ser a URL gerada pelo banco interno do Render.
# Exemplo gerado automaticamente pelo Render:
# DATABASE_URL=postgres://usuario:senha@host.render.com:5432/banco?sslmode=require
